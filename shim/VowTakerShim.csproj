<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Framework 4.8 ships with Windows, so the shim needs no runtime install. -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RuneLite</AssemblyName>
    <RootNamespace>VowTakerShim</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>RuneLite</AssemblyTitle>
    <Product>RuneLite</Product>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
